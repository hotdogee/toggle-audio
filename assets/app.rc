// Resources for toggle-audio.exe and toggle-audiow.exe, compiled by build.rs (embed-resource).
// Both binaries get the same manifest, icon, dialog and version; only BIN_NAME differs.
// build.rs defines VER_MAJOR, VER_MINOR and VER_PATCH from Cargo.toml so VERSIONINFO never drifts.
#pragma code_page(65001)
#include <windows.h>
#include "resource.h"

// The executable's base name, for InternalName and OriginalFilename. toggle-audio.exe compiles this
// file directly; toggle-audiow.exe compiles app-windowed.rc, which defines BIN_NAME first.
#ifndef BIN_NAME
#define BIN_NAME "toggle-audio"
#endif

#define STR_(x) #x
#define STR(x) STR_(x)
#define VER_STR STR(VER_MAJOR) "." STR(VER_MINOR) "." STR(VER_PATCH)

// Manifest: RT_MANIFEST, id 1 (CREATEPROCESS_MANIFEST_RESOURCE_ID) for an .exe.
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

// First icon resource in the file = Explorer / shortcut / Apps & features icon.
IDI_APP ICON "app.ico"

// Settings dialog. Units are dialog units (DLU): 4 horizontal DLU = average character width and
// 8 vertical DLU = character height of the dialog font, so the layout scales with font and DPI.
// DS_SETFOREGROUND: a first-run dialog opened by a hotkey must not hide behind the active window.
IDD_SETTINGS DIALOGEX 0, 0, 300, 149
STYLE DS_SETFONT | DS_MODALFRAME | DS_SETFOREGROUND | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Toggle Audio Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Device &1:", -1, 7, 9, 50, 8
    COMBOBOX        IDC_DEV1, 60, 7, 233, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Device &2:", -1, 7, 27, 50, 8
    COMBOBOX        IDC_DEV2, 60, 25, 233, 160, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "Also switch the &Communications device", IDC_COMMS, 60, 43, 233, 10, WS_TABSTOP
    LTEXT           "Progra&m path for Logitech G HUB (System > Launch Application):", -1, 7, 62, 286, 8
    EDITTEXT        IDC_PATH, 7, 73, 236, 14, ES_AUTOHSCROLL | ES_READONLY | WS_TABSTOP
    PUSHBUTTON      "Cop&y", IDC_COPY, 247, 73, 46, 14, WS_TABSTOP
    // Three lines: error texts can carry a device name or a path.
    LTEXT           "", IDC_STATUS, 7, 95, 286, 26, SS_NOPREFIX | SS_LEFT
    PUSHBUTTON      "&Test toggle", IDC_TEST, 7, 128, 60, 14, WS_TABSTOP
    DEFPUSHBUTTON   "&Save", IDOK, 183, 128, 52, 14, WS_TABSTOP
    PUSHBUTTON      "Cancel", IDCANCEL, 241, 128, 52, 14, WS_TABSTOP
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
 PRODUCTVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Han Lin"
            VALUE "FileDescription", "Toggle Audio"
            VALUE "FileVersion", VER_STR
            VALUE "InternalName", BIN_NAME
            VALUE "LegalCopyright", "Copyright (c) 2026 Han Lin. MIT License."
            VALUE "OriginalFilename", BIN_NAME ".exe"
            VALUE "ProductName", "Toggle Audio"
            VALUE "ProductVersion", VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
