# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.rs]
indent_size = 4

[*.{toml,yml,yaml,json,md,wxs,wxl}]
indent_size = 2

# Markdown uses two trailing spaces for hard line breaks
[*.md]
trim_trailing_whitespace = false

# Windows-native formats keep CRLF (matches .gitattributes)
[*.{ps1,psm1,bat,cmd,rc,wxs,wxl,sln,vcxproj,csproj}]
end_of_line = crlf

# Windows PowerShell 5.1 misreads BOM-less UTF-8 (CJK device names)
[*.{ps1,psm1}]
charset = utf-8-bom

[Makefile]
indent_style = tab

[*.go]
indent_style = tab
